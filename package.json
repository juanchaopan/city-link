{
  "name": "city-link",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @city-link/client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "arch": "node scripts/arch-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "miniprogram-ci": "^2.1.31",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
